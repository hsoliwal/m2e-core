<!--
  Maven plug-ins that compile languages without an Eclipse builder. Their executions go to the language plug-in
  configurator: the project imports without "not covered by lifecycle configuration" problems, gets a language
  server for the language, and Maven keeps compiling. The configurator runs after the Groovy-Eclipse and Kotlin for
  Eclipse configurators when those are installed, so their mappings of the same goals stay primary.
  The xml-maven-plugin is not listed: its jar embeds its own mapping (execute), which this file must not override.
-->
<lifecycleMappingMetadata>
	<pluginExecutions>
		<pluginExecution>
			<pluginExecutionFilter>
				<groupId>org.codehaus.gmavenplus</groupId>
				<artifactId>gmavenplus-plugin</artifactId>
				<versionRange>[1.0,1.6)</versionRange>
				<goals>
					<goal>addSources</goal>
					<goal>addTestSources</goal>
					<goal>generateStubs</goal>
					<goal>compile</goal>
					<goal>removeStubs</goal>
					<goal>testGenerateStubs</goal>
					<goal>testCompile</goal>
					<goal>removeTestStubs</goal>
				</goals>
			</pluginExecutionFilter>
			<action>
				<configurator>
					<id>org.eclipse.m2e.polyglot.languagePlugins</id>
				</configurator>
			</action>
		</pluginExecution>
		<pluginExecution>
			<pluginExecutionFilter>
				<groupId>org.codehaus.gmavenplus</groupId>
				<artifactId>gmavenplus-plugin</artifactId>
				<versionRange>[1.6,)</versionRange>
				<goals>
					<goal>addSources</goal>
					<goal>addTestSources</goal>
					<goal>addStubSources</goal>
					<goal>addTestStubSources</goal>
					<goal>generateStubs</goal>
					<goal>generateTestStubs</goal>
					<goal>compile</goal>
					<goal>compileTests</goal>
					<goal>removeStubs</goal>
					<goal>removeTestStubs</goal>
				</goals>
			</pluginExecutionFilter>
			<action>
				<configurator>
					<id>org.eclipse.m2e.polyglot.languagePlugins</id>
				</configurator>
			</action>
		</pluginExecution>
		<pluginExecution>
			<pluginExecutionFilter>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-maven-plugin</artifactId>
				<versionRange>[1.0.0,)</versionRange>
				<goals>
					<goal>compile</goal>
					<goal>test-compile</goal>
					<goal>kapt</goal>
					<goal>test-kapt</goal>
				</goals>
			</pluginExecutionFilter>
			<action>
				<configurator>
					<id>org.eclipse.m2e.polyglot.languagePlugins</id>
				</configurator>
			</action>
		</pluginExecution>
	</pluginExecutions>
</lifecycleMappingMetadata>
